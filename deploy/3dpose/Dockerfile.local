ARG VIEWER_BASE_IMAGE=nginx:1.27-alpine
FROM ${VIEWER_BASE_IMAGE}
ARG CODE_REVISION=unknown
LABEL org.opencontainers.image.revision=$CODE_REVISION
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY public/ /usr/share/nginx/html/
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
